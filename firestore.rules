rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 「マイページコード」による本人確認は、Firebase Authではなくアプリ側で
    // 行っています（複数端末から同じ自分に戻れるようにするため）。
    // そのため、ここでの制限は「ログインしている人だけ」までとしています。
    // 少人数の身内テストであることを前提にした、簡易的なルールです。

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // つながり（旧: matches）。コーディネーターが誰でも作れるよう、
    // 参加者以外（コーディネーター）による作成も許可しています。
    match /connections/{connId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }

    // 管理者（市職員・事務局：レポート・全チャット閲覧・補助金の設定など）。
    // 以前は「合言葉」方式だったが、合言葉がこのファイルごと公開リポジトリに載って
    // しまうため廃止した。現在は、許可リストに載ったGoogleアカウントでログインした
    // 人だけが自己登録できる。許可リストはFirestoreの config/adminEmails
    // （{ emails: ["xxx@example.com", ...] }）に置き、Firebaseコンソールから手動で
    // 編集する（公開リポジトリにメールアドレスを載せないため）。
    // 登録先は adminUsers/{authUid}。GoogleアカウントのuidはどのPC・スマホでも同じなので、
    // 端末を替えても再登録は要らない。旧 admins コレクションは参照しない（＝旧合言葉で
    // 登録された管理者は自動的に無効になる）。
    match /adminUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email in get(/databases/$(database)/documents/config/adminEmails).data.emails;
      allow update, delete: if false;
    }

    // 許可リストの置き場。クライアントからは読み書きとも不可（ルール内のget()でのみ参照される）。
    match /config/{docId} {
      allow read, write: if false;
    }

    // 実証KPIの設定（実証期間・目標値）と、職員の対応ログ（問い合わせ対応にかけた時間の記録）。
    // どちらも読み書きとも管理者だけ。対応ログには個人名・連絡先を書かない運用とする。
    match /kpiSettings/{docId} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }
    match /staffLogs/{logId} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    // 校区ダッシュボード用：各校区の子ども食堂の設置数（districtInfo/main = { shokudo: { 校区名: 数 } }）。
    // 誰でも読めるが、書き込めるのは管理者だけ。個人情報は含まない。
    match /districtInfo/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    // 補助金ガイド用の、市が登録する制度情報（募集要項PDFのURL・お知らせ）。
    // 誰でも読めるが、書き込めるのは上のadminUsersに登録された管理者だけ。
    // 申請者が入力する団体名・住所などの個人情報は、サーバーには送らず
    // 端末内（localStorage）にだけ保存するため、ここには置かない。
    match /subsidyPrograms/{programId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }
  }
}
